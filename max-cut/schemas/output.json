{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "group_a",
    "group_b",
    "cut_weight",
    "total_weight"
  ],
  "properties": {
    "group_a": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Group A"
    },
    "group_b": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Group B"
    },
    "cut_weight": {
      "type": "number",
      "title": "Weight of the cut"
    },
    "total_weight": {
      "type": "number",
      "title": "Total edge weight"
    }
  }
}
